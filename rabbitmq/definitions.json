{
   "users": [
    {
      "name": "guest",
      "password": "guest",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "document.exchange",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false
    }
  ],
  "queues": [
    {
      "name": "document.verification.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "document.verification.result.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "document.vector.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "document.email.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    }
  ],
  "bindings": [
    {
      "source": "document.exchange",
      "vhost": "/",
      "destination": "document.verification.queue",
      "destination_type": "queue",
      "routing_key": "document.verification.requested"
    },
    {
      "source": "document.exchange",
      "vhost": "/",
      "destination": "document.verification.result.queue",
      "destination_type": "queue",
      "routing_key": "document.verification.completed"
    },
    {
      "source": "document.exchange",
      "vhost": "/",
      "destination": "document.vector.queue",
      "destination_type": "queue",
      "routing_key": "document.vector.routing_key"
    },
    {
      "source": "document.exchange",
      "vhost": "/",
      "destination": "document.email.queue",
      "destination_type": "queue",
      "routing_key": "document.email.routing_key"
    }
  ]
